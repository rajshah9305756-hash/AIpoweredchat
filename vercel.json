{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:vercel",
  "outputDirectory": "public",
  "functions": {
    "api/trpc/index.ts": {
      "maxDuration": 30
    },
    "api/trpc/[...path].ts": {
      "maxDuration": 30
    }
  }
}
